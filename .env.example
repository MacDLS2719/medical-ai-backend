# Database
DATABASE_URL=postgresql://user:password@localhost:5432/medical_ai

# Security
SECRET_KEY=your-secret-key-for-dev-change-in-prod

# Translation Service Configuration
# Options: "deepl", "google", "argos"
TRANSLATION_SERVICE=deepl

# DeepL API Key (obténla en https://www.deepl.com/pro-api)
DEEPL_API_KEY=your-deepl-api-key-here

# Google Translate API Key (opcional, como fallback)
# Obténla en https://cloud.google.com/translate/docs/setup
GOOGLE_TRANSLATE_API_KEY=

# Use local translation (argostranslate) - Set to true for local development
# Set to false for production to avoid resource consumption
USE_LOCAL_TRANSLATION=false

# Debug mode
DEBUG=true